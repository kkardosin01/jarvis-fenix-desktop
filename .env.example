# Só para desenvolvimento. Em produção tudo é configurado na tela Configurações
# e guardado criptografado (safeStorage / DPAPI do Windows).

# Pasta de dados alternativa (útil para testes; não use em produção)
JARVIS_USER_DATA=

# Token do GitHub com permissão "contents: read & write" no repositório privado
# de releases. Usado APENAS na máquina que publica (npm run release:win).
GH_TOKEN=
