{
  "name": "jarvis-fenix-desktop",
  "productName": "Jarvis Fênix",
  "version": "0.1.0",
  "description": "Central de comando da Comercial Fênix SC Ltda",
  "author": "Comercial Fênix SC Ltda",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "icon": "node scripts/gerar-icone.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@googleapis/sheets": "18.1.1",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "google-auth-library": "11.3.1",
    "imapflow": "2.5.8",
    "mailparser": "3.10.0",
    "pdfjs-dist": "5.4.296",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jarvis-fenix-core": "file:vendor/jarvis-fenix-core-0.1.0.tgz",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
